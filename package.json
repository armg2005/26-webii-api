  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --watch generated/prisma --ext js,ts,json --exec tsx src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:pratica": "vitest run --exclude tests/upload-v2.test.js && vitest run tests/upload-v2.test.js -t Prática",
    "test:atividade": "vitest run tests/upload-v2.test.js -t Atividade",
    "fixtures:upload": "node tests/fixtures/createUploadFixtures.js",
    "serve:avaliacao": "tsx tests/serve-evaluation.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurfporto/26-webii-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/arthurfporto/26-webii-api/issues"
  },
  "homepage": "https://github.com/arthurfporto/26-webii-api#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@uploadcare/upload-client": "^6.25.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.5.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.10.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "prisma@7.9.1": true
  }
}
